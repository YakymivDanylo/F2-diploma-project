filters:
  and:
    - file.inFolder("F2_Diploma_Yakymiv_DR/Calendar-Plan")
properties:
  stage_no:
    displayName: № з/п
  stage_name:
    displayName: Назва етапу кваліфікаційної роботи
  deadline:
    displayName: Термін виконання етапів проєкту
  status:
    displayName: Примітка / Статус виконання
  task_ref:
    displayName: Завдання наукового апарату
  start:
    displayName: Початок
  end:
    displayName: Завершення
views:
  - type: table
    name: Календарний план
    order:
      - stage_no
      - stage_name
      - deadline
      - status
      - task_ref
    sort:
      - property: stage_no
        direction: ASC
    columnSize:
      note.stage_name: 644
