NODE_ID=node1
ISSUER_ID=issuer1
NODE_HOST=localhost            # advertised address used in peer registration
NODE_PORT=8000
CONSENSUS_MODE=pbft            # pow | pbft, no default
EXPECTED_DIFFICULTY=8          # required for pow only (leading zero bits, 1..256)
ISSUER_KEY_PATH=data/node1/issuer.pem
NODE_KEY_PATH=data/node1/node.pem
CHAIN_PATH=data/node1/chain.json
VALIDATORS_PATH=config/validators.json
ISSUERS_PATH=config/issuers.json
SEED_PEERS=
CORS_ORIGINS=http://localhost:5173
MAX_PAGE_SIZE=100
METADATA_MAX_BYTES=1024
MAX_FUTURE_SKEW_MS=60000
INIT_CHAIN=0                   # 1 only for the very first start of a new node
STARTUP_SYNC_TIMEOUT_S=10      # seconds (float, >=0): bound on the sync-before-serving wait
SYNC_INTERVAL_S=5              # seconds (float, >=0.05): period of the background chain sync
PBFT_ROUND_TIMEOUT_S=5         # seconds (float, >=0.05): PBFT round / unreachable-primary timeout before a view change
FORWARD_ACK_TIMEOUT_MS=2000    # PBFT: wait for the primary reply to a forwarded record (>=1)
MEMPOOL_MAX_SIZE=10000         # pending + in-flight records; beyond it POST /documents gives 503
