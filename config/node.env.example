NODE_ID=node1
ISSUER_ID=issuer1
NODE_HOST=localhost            # advertised address used in peer registration; with SEED_PEERS set it must be reachable by peers (not localhost/loopback) unless ALLOW_LOOPBACK_PEERS=1
NODE_PORT=8000
CONSENSUS_MODE=pbft            # pow | pbft, no default
EXPECTED_DIFFICULTY=8          # required for pow only (leading zero bits, 1..256)
ISSUER_KEY_PATH=data/node1/issuer.pem
NODE_KEY_PATH=data/node1/node.pem
CHAIN_PATH=data/node1/chain.json
VALIDATORS_PATH=config/validators.json
ISSUERS_PATH=config/issuers.json
SEED_PEERS=                    # host:port,...; registered with in parallel and re-registered every 30 s
ALLOW_LOOPBACK_PEERS=0         # 1 only for single-machine development: accept localhost/127.x peer addresses and a localhost NODE_HOST
CORS_ORIGINS=http://localhost:5173
MAX_PAGE_SIZE=100              # 1..1000
METADATA_MAX_BYTES=1024
MAX_FUTURE_SKEW_MS=60000       # ms (>=1000): clock-skew bound for timestamps; inbound PoW blocks older than now minus this are also rejected
INIT_CHAIN=0                   # 1 only for the very first start of a new node
STARTUP_SYNC_TIMEOUT_S=10      # seconds (float, >=0): bound on the sync-before-serving wait
SYNC_INTERVAL_S=5              # seconds (float, >=0.05): period of the background chain sync
PBFT_ROUND_TIMEOUT_S=5         # seconds (float, >=0.05): PBFT round / unreachable-primary timeout before a view change
FORWARD_ACK_TIMEOUT_MS=2000    # PBFT: wait for the primary reply to a forwarded record (>=1)
MEMPOOL_MAX_SIZE=10000         # pending + in-flight records; beyond it POST /documents gives 503
PBFT_ALLOW_MISSING_STATE=0     # PBFT: 1 = start even if the PBFT state file is missing while the chain has blocks (default 0: fail closed, a lost vote record could allow a double vote); a WARNING is logged on every boot while it is set - unset it after that one start
# BYZANTINE_RESET_ON_BOOT=<token>      # PBFT, unset by default: operator reset of the sticky byzantine_event_detected status with a one-shot DIGEST token - every boot that restores persisted Byzantine events logs a WARNING with the current token (16 hex chars: SHA-256 of exactly the persisted event list); only that exact token discards them (and clears them from the PBFT state file) with a WARNING; any other value is refused with a WARNING and nothing is discarded, so a stale value never erases newer evidence; unset it after that start
# Request body limits (fixed, not configurable): POST /documents 4*METADATA_MAX_BYTES+1024 bytes,
# POST /peers/register 8 KiB, every other request 16 KiB; a larger body gets 413 payload_too_large.
